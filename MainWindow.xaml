<Window x:Class="VpnClient.MainWindow"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VpnClient"
        Title="BearNest" Height="640" Width="740"
        MinWidth="100" MinHeight="200"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="WinBtn" TargetType="Button" BasedOn="{StaticResource BtnNormal}"/>
        <local:LogColorConverter x:Key="LogColorConverter"/>
        <local:LogHasDomainConverter x:Key="LogHasDomainConverter"/>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- СТРОКА ЛОГА: read-only TextBox даёт нативное выделение       -->
        <!-- текста мышью (TextBlock этого не умеет).                    -->
        <!-- Кастомный Template убирает рамку/фон/скроллбары,            -->
        <!-- чтобы визуально это выглядело как обычный текст.            -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Style x:Key="LogLineTextBox" TargetType="TextBox">
            <Setter Property="IsReadOnly"               Value="True"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Padding"                  Value="0"/>
            <Setter Property="Margin"                   Value="0"/>
            <Setter Property="FontFamily"               Value="Segoe UI Emoji, Consolas"/>
            <Setter Property="FontSize"                 Value="{DynamicResource FontSizeSmall}"/>
            <Setter Property="TextWrapping"             Value="NoWrap"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor"                   Value="IBeam"/>
            <Setter Property="SelectionBrush"           Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="shell:WindowChrome.WindowChrome">
                <Setter.Value>
                    <shell:WindowChrome
                    ResizeBorderThickness="6"
                    CaptionHeight="0"
                    GlassFrameThickness="0"
                    UseAeroCaptionButtons="False"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Style>
    <Border Background="{DynamicResource BrushBackground}"
    BorderBrush="{DynamicResource BrushAccent}"
    BorderThickness="1.5"
    CornerRadius="12">
        <Grid>
            <Grid Margin="22,20,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Кастомный заголовок -->
                <Grid Grid.Column="0"
                  MouseLeftButtonDown="TitleBar_MouseDown"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Grid Grid.Column="0"
                                  MouseLeftButtonDown="TitleBar_MouseDown"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                   Background="Transparent">
                            <emoji:TextBlock Text="🐻 BearNest"
                         Foreground="{DynamicResource BrushText}"
                         FontSize="14" 
                         FontWeight="Bold"
                         VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="─"
                                    Click="BtnMinimize_Click"
                                    Width="32" Height="26"
                                    Style="{StaticResource BtnNormal}"
                                    Margin="0,0,4,0"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="✕"
                                Click="BtnClose_Click"
                                Width="32" Height="26"
                                Background="{DynamicResource BrushButtonStop}"
                                Foreground="{DynamicResource BrushButtonFg}"
                                Style="{StaticResource BtnAccent}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
                <!-- Строка статуса -->
                <Grid Grid.Row="1" Margin="0,0,0,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Статус подключения + таймер -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="11.991"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="StatusText"
               Text="{DynamicResource StatusStopped}" 
                   Foreground="{DynamicResource BrushDisconnected}"
                   FontSize="{DynamicResource FontSizeLarge}"
                   FontWeight="Bold"
                   VerticalAlignment="Center" HorizontalAlignment="Left" Width="697" RenderTransformOrigin="0.508,0.419" Grid.ColumnSpan="3"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="2">
                            <TextBlock x:Name="TrafficText"
                       Text=""
                       Foreground="{DynamicResource BrushAccent}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       FontFamily="Consolas"
                       VerticalAlignment="Center"
                       Margin="0,0,15,0"/>
                            <TextBlock x:Name="TimerText"
                       Text=""
                       Foreground="{DynamicResource BrushConnected}"
                       FontSize="{DynamicResource FontSizeNormal}"
                       FontFamily="Consolas"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Статус подписки -->
                    <Border Grid.Row="1"
                    x:Name="SubInfoPanel"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Название подписки -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <emoji:TextBlock Text="📡 " FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SubTitleText"
                           Text="—"
                           Foreground="{DynamicResource BrushText}"
                           FontSize="13" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Трафик -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                 Margin="15,0">
                                <emoji:TextBlock Text="↑↓ " Foreground="{DynamicResource BrushTextMuted}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SubTrafficText"
                           Text="—"
                           Foreground="{DynamicResource BrushAccent}"
                           FontSize="12" FontFamily="Consolas"
                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Срок -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <emoji:TextBlock Text="⏰ " Foreground="{DynamicResource BrushTextMuted}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SubExpireText"
                           Text="—"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                    </Border>
                </Grid>

                <!-- Поле подписки -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SubUrlBox"
                     Grid.Column="0"
                     Style="{StaticResource InputStyle}"
                     Margin="0,0,10,0"/>

                    <Button x:Name="BtnLoadSub"
                                    Grid.Column="1" 
                                    Click="BtnLoadSub_Click"
                                    Height="36"
                                    Style="{StaticResource BtnAccent}"
                                    Background="{DynamicResource BrushButtonLoad}">
                        <emoji:TextBlock Text="{DynamicResource BtnLoad}"/>
                    </Button>
                </Grid>

                <!-- ══════════════════════════════════════════════════ -->
                <!-- Кнопки управления                                  -->
                <!-- ИЗМЕНЕНО: StackPanel → Grid, чтобы чекбокс TUN     -->
                <!-- прижался к правому краю                            -->
                <!-- ══════════════════════════════════════════════════ -->
                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кнопки (содержимое не изменилось) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="BtnStart"
                                Click="BtnStart_Click"
                                Width="150" Height="40"
                                Style="{StaticResource BtnAccent}"
                                Background="{DynamicResource BrushButtonConnect}"
                                Margin="0,0,10,0">
                            <emoji:TextBlock Text="{DynamicResource BtnConnect}"/>
                        </Button>
                        <Button x:Name="BtnSwitch"
                                Click="BtnSwitch_Click"
                                Width="140" Height="40"
                                Style="{StaticResource BtnAccent}"
                                Background="{DynamicResource BrushButtonLoad}"
                                IsEnabled="False"
                                Margin="0,0,10,0">
                            <emoji:TextBlock Text="{DynamicResource BtnSwitch}"/>
                        </Button>
                        <Button x:Name="BtnStop"
                                Click="BtnStop_Click"
                                Width="150" Height="40"
                                Style="{StaticResource BtnAccent}"
                                Background="{DynamicResource BrushButtonStop}"
                                IsEnabled="False"
                                Margin="0,0,10,0">
                            <emoji:TextBlock Text="{DynamicResource BtnDisconnect}"/>
                        </Button>
                        <Button x:Name="BtnPing"
                                Click="BtnPing_Click"
                                Width="130" Height="40"
                                Style="{StaticResource BtnAccent}"
                                Background="{DynamicResource BrushButtonPing}">
                            <emoji:TextBlock Text="{DynamicResource BtnPing}"/>
                        </Button>
                    </StackPanel>

                    <!-- ДОБАВЛЕНО: переключатель TUN-режима -->
                    <!--
                        Обработчики Checked/Unchecked НЕ вешаются здесь в XAML.
                        Они подписываются в конструкторе MainWindow ПОСЛЕ
                        восстановления сохранённого состояния — иначе при
                        старте сработает обработчик и запишет в лог мусор.
                    -->
                    <StackPanel Grid.Column="2"
                                Orientation="Vertical"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <CheckBox x:Name="ChkTunMode"
                                  VerticalAlignment="Center"
                                  FontSize="13">
                            <emoji:TextBlock Text="🌐 TUN"
                                             Foreground="{DynamicResource BrushText}"
                                             FontWeight="Bold"/>
                        </CheckBox>
                        <TextBlock x:Name="TunStatusText"
                                   Text=""
                                   Foreground="{DynamicResource BrushConnected}"
                                   FontSize="10"
                                   Margin="0,2,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Выбранный сервер -->
                <TextBlock x:Name="SelectedServerText"
                  Text="{DynamicResource NoServer}"
                   Grid.Row="4" 
                   Foreground="{DynamicResource BrushConnected}"
                   FontSize="{DynamicResource FontSizeNormal}"
                   Margin="0,0,0,8"/>

                <!-- TabControl -->
                <TabControl Grid.Row="5"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1">

                    <!-- ══════════════════════════════════════════════ -->
                    <!-- Вкладка: Серверы                              -->
                    <!-- ══════════════════════════════════════════════ -->
                    <TabItem>
                        <TabItem.Header>
                            <emoji:TextBlock Text="{DynamicResource TabServers}"/>
                        </TabItem.Header>
                        <ListView x:Name="ServerList"
                          Style="{StaticResource ServerListStyle}"
                          ItemContainerStyle="{StaticResource ServerRowStyle}"
                          SelectionChanged="ServerList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{DynamicResource ColServer}" Width="340">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <emoji:TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{DynamicResource ColProtocol}" Width="90"
                                          DisplayMemberBinding="{Binding Protocol}"/>
                                    <GridViewColumn Header="{DynamicResource ColPing}" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <emoji:TextBlock Text="{Binding PingDisplay}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <!-- ══════════════════════════════════════════════ -->
                    <!-- Вкладка: Лог                                  -->
                    <!-- ══════════════════════════════════════════════ -->
                    <TabItem>
                        <TabItem.Header>
                            <emoji:TextBlock Text="{DynamicResource TabLog}"/>
                        </TabItem.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!--
                                ИЗМЕНЕНИЯ:
                                  • Каждая строка теперь = read-only TextBox → можно ВЫДЕЛЯТЬ ТЕКСТ мышью
                                  • При наведении на строку с доменом всплывает кнопка "➕ в обход"
                                  • SelectionMode/Ctrl+C/контекстное меню оставлены как запасной способ
                            -->
                            <ListBox x:Name="LogBox"
                                     Grid.Row="0"
                                     SelectionMode="Extended"
                                     PreviewKeyDown="LogBox_PreviewKeyDown"
                                     Style="{StaticResource LogStyle}"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     AlternationCount="2"
                                     ItemContainerStyle="{StaticResource LogItemStyle}">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="📋 Копировать выделенное"
                                                  Click="LogBox_CopySelected_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Выделить всё"
                                                  Click="LogBox_SelectAll_Click"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Grid Background=Transparent → ховер ловится по всей строке -->
                                        <Grid Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Текст строки: read-only TextBox = выделяется мышью -->
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Mode=OneWay}"
                                                     Style="{StaticResource LogLineTextBox}"
                                                     Foreground="{Binding Converter={StaticResource LogColorConverter}}"/>

                                            <!-- Кнопка "добавить в обход": видна при наведении И если в строке есть домен -->
                                            <Button Grid.Column="1"
                                                    Click="BtnAddLogToBypass_Click"
                                                    VerticalAlignment="Center"
                                                    Margin="6,0,2,0"
                                                    Padding="0"
                                                    Height="22"
                                                    ToolTip="Добавить домен из этой строки в список обхода (Bypass)">
                                                <emoji:TextBlock Text="➕ в обход" FontSize="11"/>
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BtnNormal}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                                    <Condition Binding="{Binding Converter={StaticResource LogHasDomainConverter}}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Grid.Row="1" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Фильтр -->
                                <ComboBox x:Name="CmbLogFilter"
                                                Grid.Column="0"
                                                Width="130" Height="28"
                                                SelectionChanged="CmbLogFilter_SelectionChanged"
                                                Margin="0,0,8,0"/>

                                <!-- Кнопка паузы -->
                                <Button x:Name="BtnPauseLog"
                                            Grid.Column="2"
                                            Click="BtnPauseLog_Click"
                                            Width="100" Height="28"
                                            Style="{StaticResource BtnNormal}"
                                            Margin="0,0,8,0">
                                    <emoji:TextBlock Text="⏸ Пауза"/>
                                </Button>

                                <!-- Кнопка очистить -->
                                <Button Grid.Column="3"
                                            Click="BtnClearLog_Click" Width="130" Height="28"
                                            Style="{StaticResource BtnNormal}">
                                    <emoji:TextBlock Text="{DynamicResource BtnClearLog}"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- ══════════════════════════════════════════════ -->
                    <!-- Вкладка: Настройки                            -->
                    <!-- ══════════════════════════════════════════════ -->
                    <TabItem>
                        <TabItem.Header>
                            <emoji:TextBlock Text="{DynamicResource TabSettings}"/>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="15">

                                <!-- Тема -->
                                <emoji:TextBlock Text="{DynamicResource ThemeLabel}"
                                   Foreground="{DynamicResource BrushAccent}"
                                   FontSize="{DynamicResource FontSizeTitle}"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <ComboBox x:Name="CmbTheme"
                                            Width="200" Height="34"
                                            SelectionChanged="CmbTheme_SelectionChanged"
                                            Margin="0,0,10,0"/>
                                    <Button Click="BtnThemeEditor_Click" Width="110" Height="34"
                                                    Style="{StaticResource BtnNormal}" Margin="0,0,10,0">
                                        <emoji:TextBlock Text="{DynamicResource BtnThemeEditor}"/>
                                    </Button>
                                    <Button Click="BtnLoadTheme_Click" Width="139" Height="34"
                                                    Style="{StaticResource BtnNormal}">
                                        <emoji:TextBlock Text="{DynamicResource BtnLoadTheme}"/>
                                    </Button>
                                </StackPanel>

                                <Separator Margin="0,0,0,15"/>
                                <!-- Язык -->
                                <emoji:TextBlock Text="🌐 Language / Язык"
                                   Foreground="{DynamicResource BrushAccent}"
                                   FontSize="{DynamicResource FontSizeTitle}"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <ComboBox x:Name="CmbLanguage"
                                          Width="150" Height="34"
                                          SelectionChanged="CmbLanguage_SelectionChanged"/>
                                </StackPanel>

                                <Separator Margin="0,0,0,15"/>
                                <!-- Автозапуск -->
                                <CheckBox x:Name="ChkAutoStart"
                                            Content="Launch the application at Windows startup"
                                            Checked="ChkAutoStart_Checked"
                                            Unchecked="ChkAutoStart_Unchecked"
                                            Margin="0,8,0,8"
                                            VerticalAlignment="Center"
                                            FontSize="13"/>
                                <Separator Margin="0,0,0,15"/>

                                <!-- Логи -->
                                <emoji:TextBlock Text="{DynamicResource LogsLabel}" 
                                   Foreground="{DynamicResource BrushAccent}"
                                   FontSize="{DynamicResource FontSizeTitle}"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

                                <Button Click="BtnOpenLogs_Click" Width="180" Height="34"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource BtnNormal}" Margin="0,0,0,15">
                                    <emoji:TextBlock Text="{DynamicResource BtnOpenLogs}"/>
                                </Button>

                                <Separator Margin="0,0,0,15"/>

                                <!-- Бэкап -->
                                <emoji:TextBlock Text="{DynamicResource BackupLabel}" 
                               Foreground="{DynamicResource BrushAccent}"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Button Click="BtnExportSettings_Click" Width="120" Height="34"
                                                                   Style="{StaticResource BtnNormal}" Margin="0,0,10,0">
                                        <emoji:TextBlock Text="{DynamicResource BtnExport}"/>
                                    </Button>
                                    <Button Click="BtnImportSettings_Click" Width="120" Height="34"
                                                                 Style="{StaticResource BtnNormal}">
                                        <emoji:TextBlock Text="{DynamicResource BtnImport}"/>
                                    </Button>
                                </StackPanel>

                                <Separator Margin="0,0,0,15"/>

                                <!-- Xray путь -->
                                <emoji:TextBlock Text="{DynamicResource XrayLabel}" 
                               Foreground="{DynamicResource BrushAccent}"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="TxtXrayPath"
                                 Width="420" Height="34"
                                 Style="{StaticResource InputStyle}"
                                 FontFamily="Consolas"
                                 Margin="0,0,10,0"/>
                                    <Button Click="BtnSaveXrayPath_Click" Width="100" Height="34"
                                                Style="{StaticResource BtnAccent}"
                                                Background="{DynamicResource BrushButtonConnect}">
                                        <emoji:TextBlock Text="{DynamicResource BtnSave}"/>
                                    </Button>
                                </StackPanel>

                                <!-- Split Tunneling ПЕРЕНЕСЁН в отдельную вкладку 🔀 Bypass -->

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══════════════════════════════════════════════ -->
                    <!-- Вкладка: Bypass (Split Tunneling)             -->
                    <!-- ══════════════════════════════════════════════ -->
                    <TabItem>
                        <TabItem.Header>
                            <emoji:TextBlock Text="🔀 Bypass"/>
                        </TabItem.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Шапка + быстрое добавление (фиксированная) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Поля доменов / IP (скроллируемые) -->
                                <RowDefinition Height="*"/>
                                <!-- Кнопки сохранить/очистить (фиксированные) -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ── Шапка + быстрое добавление ── -->
                            <StackPanel Grid.Row="0" Margin="15,12,15,8">
                                <emoji:TextBlock Text="🔀 Split Tunneling"
                                    Foreground="{DynamicResource BrushAccent}"
                                    FontSize="{DynamicResource FontSizeTitle}"
                                    FontWeight="Bold"
                                    Margin="0,0,0,3"/>
                                <TextBlock Text="Traffic on these domains/IP addresses will go directly, bypassing the VPN."
                                    Foreground="{DynamicResource BrushTextMuted}"
                                    FontSize="11"
                                    Margin="0,0,0,4"/>
                                <!-- ДОБАВЛЕНО: пояснение про TUN -->
                                <TextBlock Text="Работает в обоих режимах — и через системный прокси, и через TUN."
                                    Foreground="{DynamicResource BrushTextMuted}"
                                    FontSize="10"
                                    FontStyle="Italic"
                                    Margin="0,0,0,10"/>

                                <!-- Быстрое добавление домена / URL -->
                                <TextBlock Text="Quick add — paste domain or full URL:"
                                    Foreground="{DynamicResource BrushText}"
                                    FontSize="12"
                                    Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtQuickDomain"
                                        Grid.Column="0"
                                        Style="{StaticResource InputStyle}"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Height="32"
                                        Margin="0,0,8,0"/>
                                    <Button Grid.Column="1"
                                        Click="BtnAddDomainManual_Click"
                                        Width="80" Height="32"
                                        Style="{StaticResource BtnAccent}"
                                        Background="{DynamicResource BrushButtonConnect}"
                                        Margin="0,0,6,0">
                                        <emoji:TextBlock Text="➕ Add"/>
                                    </Button>
                                    <Button Grid.Column="2"
                                        Click="BtnAddFromClipboard_Click"
                                        Width="175" Height="32"
                                        Style="{StaticResource BtnNormal}">
                                        <emoji:TextBlock Text="📋 Add from clipboard"/>
                                    </Button>
                                </Grid>

                                <!-- Bypass LAN чекбокс -->
                                <CheckBox x:Name="ChkBypassLan"
                                    Content="Local network directly (192.168.x.x, 10.x.x.x, 172.16.x.x)"
                                    IsChecked="True"
                                    Margin="0,0,0,4"
                                    FontSize="13"/>
                            </StackPanel>

                            <!-- ── Основные поля (скролл) ── -->
                            <ScrollViewer Grid.Row="1"
                                VerticalScrollBarVisibility="Auto"
                                Padding="15,0,15,0">
                                <StackPanel>
                                    <!-- Домены -->
                                    <TextBlock Text="Domains (one per line):"
                                        Foreground="{DynamicResource BrushText}"
                                        FontSize="12"
                                        Margin="0,6,0,4"/>
                                    <TextBlock Text="Example: google.com  |  domain:youtube.com  |  geosite:netflix"
                                        Foreground="{DynamicResource BrushTextMuted}"
                                        FontSize="10"
                                        Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtBypassDomains"
                                        MinHeight="140"
                                        Style="{StaticResource InputStyle}"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"
                                        TextWrapping="NoWrap"
                                        Margin="0,0,0,12"/>

                                    <!-- IP -->
                                    <TextBlock Text="IP addresses and CIDR ranges (one per line):"
                                        Foreground="{DynamicResource BrushText}"
                                        FontSize="12"
                                        Margin="0,0,0,4"/>
                                    <TextBlock Text="Example: 8.8.8.8  |  1.1.1.0/24  |  geoip:ru"
                                        Foreground="{DynamicResource BrushTextMuted}"
                                        FontSize="10"
                                        Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtBypassIPs"
                                        MinHeight="100"
                                        Style="{StaticResource InputStyle}"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"
                                        TextWrapping="NoWrap"
                                        Margin="0,0,0,8"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ── Кнопки (всегда видны внизу) ── -->
                            <StackPanel Grid.Row="2" Margin="15,8,15,12">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Click="BtnSaveSplitTunnel_Click"
                                        Width="180" Height="34"
                                        Style="{StaticResource BtnAccent}"
                                        Background="{DynamicResource BrushButtonConnect}"
                                        Margin="0,0,10,0">
                                        <emoji:TextBlock Text="💾 Save rules"/>
                                    </Button>
                                    <Button Click="BtnClearSplitTunnel_Click"
                                        Width="150" Height="34"
                                        Style="{StaticResource BtnNormal}">
                                        <emoji:TextBlock Text="🗑 Delete all rules"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="TxtSplitStatus"
                                    Text=""
                                    Foreground="{DynamicResource BrushConnected}"
                                    FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                </TabControl>
                <!-- Версия -->
                <TextBlock Grid.Row="6"
           Text="BearNest - gullampis810: v1.347.26"
           FontSize="10"
           HorizontalAlignment="Left"
           Margin="6,0,0,7"
           IsHitTestVisible="False" Foreground="#FFE6C58B" Height="14" VerticalAlignment="Bottom"/>
            </Grid>
            <!-- Toast -->
            <Border x:Name="ToastPanel"
                Background="{DynamicResource BrushSurface2}"
                BorderBrush="{DynamicResource BrushAccent}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10"
                Opacity="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Panel.ZIndex="99">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastTranslate" Y="30"/>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <emoji:TextBlock x:Name="ToastIcon" Text="✅"
                               FontSize="16" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock x:Name="ToastText" Text=""
                           Foreground="{DynamicResource BrushText}"
                           FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
