<Window x:Class="VpnClient.ThemeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="BearNest — Редактор темы"
        Height="700" Width="900"
        MinHeight="100" MinWidth="100"
        Background="{DynamicResource BrushBackground}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── ЛЕВАЯ ПАНЕЛЬ: редактор цветов ── -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <emoji:TextBlock Grid.Row="0"
                                Text="{DynamicResource ThemeEditorHeader}"
                                Foreground="{DynamicResource BrushText}"
                                FontSize="16" FontWeight="Bold"
                                Margin="0,0,0,15"/>

            <!-- Выбор базовой темы -->
            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                 <TextBlock Text="{DynamicResource BaseThemeLabel}"
                           Foreground="{DynamicResource BrushTextMuted}"
                           FontSize="12" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbBaseTheme"
                          Height="34"
                          SelectionChanged="CmbBaseTheme_SelectionChanged"/>
            </StackPanel>

            <!-- Список цветов для редактирования -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ColorPanel" Margin="0,0,5,0"/>
            </ScrollViewer>

            <!-- Кнопки -->
            <StackPanel Grid.Row="3" Margin="0,15,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Click="BtnSave_Click" Height="36" Width="150"
                                    Style="{StaticResource BtnAccent}"
                                    Background="{DynamicResource BrushButtonConnect}"
                                    Margin="0,0,10,0">
                        <emoji:TextBlock Text="{DynamicResource BtnSaveTheme}"/>
                    </Button>
                    <Button Click="BtnReset_Click" Height="36" Width="100"
                                    Style="{StaticResource BtnNormal}">
                        <emoji:TextBlock Text="{DynamicResource BtnResetEditor}"/>
                    </Button>
                </StackPanel>
                <Button Click="BtnApply_Click" Height="36"
                                Style="{StaticResource BtnAccent}"
                                Background="{DynamicResource BrushButtonLoad}">
    <emoji:TextBlock Text="{DynamicResource BtnApplyClose}"/>       
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── ПРАВАЯ ПАНЕЛЬ: превью ── -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <emoji:TextBlock Grid.Row="0"
                                        Text="👁 Превью"
                                        Foreground="{DynamicResource BrushText}"
                                        FontSize="16" FontWeight="Bold"
                                        Margin="0,0,0,15"/>


            <!-- Превью UI -->
            <Border Grid.Row="1"
                    x:Name="PreviewPanel"
                    Background="{DynamicResource BrushBackground}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15">
                <StackPanel>

                    <!-- Статус -->
                    <TextBlock Text="● Подключён"
                               Foreground="{DynamicResource BrushConnected}"
                               FontSize="18" FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <!-- Поле ввода -->
                    <TextBox Text="https://example.com/sub/token"
                             Style="{StaticResource InputStyle}"
                             Margin="0,0,0,10"
                             IsReadOnly="True"/>

                    <!-- Кнопки -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Width="130" Height="36" Style="{StaticResource BtnAccent}"
                                     Background="{DynamicResource BrushButtonConnect}" Margin="0,0,8,0">
                            <emoji:TextBlock Text="{DynamicResource BtnConnect}"/>
                        </Button>
                        <Button Width="130" Height="36" Style="{StaticResource BtnAccent}"
                                        Background="{DynamicResource BrushButtonStop}" Margin="0,0,8,0">
                            <emoji:TextBlock Text="{DynamicResource BtnDisconnect}"/>
                        </Button>
                        <Button Width="90" Height="36" Style="{StaticResource BtnAccent}"
                                    Background="{DynamicResource BrushButtonPing}">
                            <emoji:TextBlock Text="{DynamicResource BtnPing}"/>
                        </Button>
                    </StackPanel>

                    <!-- Список серверов -->
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <emoji:TextBlock Text="🇳🇱 Netherlands  |  vless  |  🟢 76 мс"
                                       Foreground="{DynamicResource BrushText}"
                                       FontSize="13" Margin="0,4"/>
                            <emoji:TextBlock Text="🇩🇪 Germany      |  vless  |  🟡 89 мс"
                                       Foreground="{DynamicResource BrushText}"
                                       FontSize="13" Margin="0,4"/>
                            <emoji:TextBlock Text="🇸🇪 Sweden       |  vless  |  🟢 54 мс"
                                       Foreground="{DynamicResource BrushAccent}"
                                       FontWeight="Bold"
                                       FontSize="13" Margin="0,4"/>
                        </StackPanel>
                    </Border>

                    <!-- Лог -->
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="[BearNest] Подключаемся к 🇸🇪 Sweden"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       FontFamily="Consolas" FontSize="11"/>
                            <TextBlock Text="[BearNest] Прокси включён → 127.0.0.1:19808"
                                       Foreground="{DynamicResource BrushConnected}"
                                       FontFamily="Consolas" FontSize="11"/>
                            <TextBlock Text="Xray 26.5.9 started"
                                       Foreground="{DynamicResource BrushText}"
                                       FontFamily="Consolas" FontSize="11"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>