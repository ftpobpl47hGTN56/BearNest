<Window x:Class="VpnClient.ThemeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BearNest — Редактор темы"
        Height="700" Width="900"
        MinHeight="100" MinWidth="100"
        Background="{DynamicResource BrushBackground}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── ЛЕВАЯ ПАНЕЛЬ: редактор цветов ── -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0"
                       Text="{DynamicResource ThemeEditorHeader}"
                       Foreground="{DynamicResource BrushText}"
                       FontSize="16" FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <!-- Выбор базовой темы -->
            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                 <TextBlock Text="{DynamicResource BaseThemeLabel}"
                           Foreground="{DynamicResource BrushTextMuted}"
                           FontSize="12" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbBaseTheme"
                          Height="34"
                          SelectionChanged="CmbBaseTheme_SelectionChanged"/>
            </StackPanel>

            <!-- Список цветов для редактирования -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ColorPanel" Margin="0,0,5,0"/>
            </ScrollViewer>

            <!-- Кнопки -->
            <StackPanel Grid.Row="3" Margin="0,15,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                 <Button Content="{DynamicResource BtnSaveTheme}" 
                            Click="BtnSave_Click"
                            Height="36" Width="150"
                            Style="{StaticResource BtnAccent}"
                            Background="{DynamicResource BrushButtonConnect}"
                            Margin="0,0,10,0"/>
                     <Button Content="{DynamicResource BtnResetEditor}"
                            Click="BtnReset_Click"
                            Height="36" Width="100"
                            Style="{StaticResource BtnNormal}"/>
                </StackPanel>
                 <Button Content="{DynamicResource BtnApplyClose}"  
                        Click="BtnApply_Click"
                        Height="36"
                        Style="{StaticResource BtnAccent}"
                        Background="{DynamicResource BrushButtonLoad}"/>
            </StackPanel>
        </Grid>

        <!-- ── ПРАВАЯ ПАНЕЛЬ: превью ── -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="👁 Превью"
                       Foreground="{DynamicResource BrushText}"
                       FontSize="16" FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <!-- Превью UI -->
            <Border Grid.Row="1"
                    x:Name="PreviewPanel"
                    Background="{DynamicResource BrushBackground}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15">
                <StackPanel>

                    <!-- Статус -->
                    <TextBlock Text="● Подключён"
                               Foreground="{DynamicResource BrushConnected}"
                               FontSize="18" FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <!-- Поле ввода -->
                    <TextBox Text="https://example.com/sub/token"
                             Style="{StaticResource InputStyle}"
                             Margin="0,0,0,10"
                             IsReadOnly="True"/>

                    <!-- Кнопки -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="{DynamicResource BtnConnect}"
                                Width="130" Height="36"
                                Style="{StaticResource BtnAccent}"
                                Background="{DynamicResource BrushButtonConnect}"
                                Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource BtnDisconnect}"
                                Width="130" Height="36"
                                Style="{StaticResource BtnAccent}"
                                Background="{DynamicResource BrushButtonStop}"
                                Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource BtnPing}"
                                Width="90" Height="36"
                                Style="{StaticResource BtnAccent}"
                                Background="{DynamicResource BrushButtonPing}"/>
                    </StackPanel>

                    <!-- Список серверов -->
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🇳🇱 Netherlands  |  vless  |  🟢 76 мс"
                                       Foreground="{DynamicResource BrushText}"
                                       FontSize="13" Margin="0,4"/>
                            <TextBlock Text="🇩🇪 Germany      |  vless  |  🟡 89 мс"
                                       Foreground="{DynamicResource BrushText}"
                                       FontSize="13" Margin="0,4"/>
                            <TextBlock Text="🇸🇪 Sweden       |  vless  |  🟢 54 мс"
                                       Foreground="{DynamicResource BrushAccent}"
                                       FontWeight="Bold"
                                       FontSize="13" Margin="0,4"/>
                        </StackPanel>
                    </Border>

                    <!-- Лог -->
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="[BearNest] Подключаемся к 🇸🇪 Sweden"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       FontFamily="Consolas" FontSize="11"/>
                            <TextBlock Text="[BearNest] Прокси включён → 127.0.0.1:19808"
                                       Foreground="{DynamicResource BrushConnected}"
                                       FontFamily="Consolas" FontSize="11"/>
                            <TextBlock Text="Xray 26.5.9 started"
                                       Foreground="{DynamicResource BrushText}"
                                       FontFamily="Consolas" FontSize="11"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>