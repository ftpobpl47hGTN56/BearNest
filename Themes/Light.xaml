    <SolidColorBrush x:Key="BrushDisconnected"    Color="#d20f39"/>
    <SolidColorBrush x:Key="BrushButtonConnect"   Color="#40a02b"/>
    <SolidColorBrush x:Key="BrushButtonStop"      Color="#d20f39"/>
    <SolidColorBrush x:Key="BrushButtonPing"      Color="#8839ef"/>
    <SolidColorBrush x:Key="BrushButtonLoad"      Color="#1e66f5"/>
    <SolidColorBrush x:Key="BrushButtonFg"        Color="#ffffff"/>
