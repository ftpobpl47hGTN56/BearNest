<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BrushBackground"      Color="#eff1f5"/>
    <SolidColorBrush x:Key="BrushSurface"         Color="#e6e9ef"/>
    <SolidColorBrush x:Key="BrushSurface2"        Color="#dce0e8"/>
    <SolidColorBrush x:Key="BrushAccent"          Color="#1e66f5"/>
    <SolidColorBrush x:Key="BrushAccentHover"     Color="#4488ff"/>
    <SolidColorBrush x:Key="BrushText"            Color="#4c4f69"/>
    <SolidColorBrush x:Key="BrushTextMuted"       Color="#9ca0b0"/>
    <SolidColorBrush x:Key="BrushBorder"          Color="#bcc0cc"/>
