<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 🖼  Фон окна -->
    <SolidColorBrush x:Key="BrushBackground" Color="#15001C"/>
    <!-- 📋 Фон панелей -->
    <SolidColorBrush x:Key="BrushSurface" Color="#000013"/>
    <!-- 🔲 Фон элементов -->
    <SolidColorBrush x:Key="BrushSurface2" Color="#3A2537"/>
    <!-- ✨ Акцент -->
    <SolidColorBrush x:Key="BrushAccent" Color="#89B4FA"/>
    <!-- ✨ Акцент (ховер) -->
    <SolidColorBrush x:Key="BrushAccentHover" Color="#B4D0FF"/>
    <!-- 📝 Текст -->
    <SolidColorBrush x:Key="BrushText" Color="#B5B9C1"/>
    <!-- 📝 Текст приглушённый -->
    <SolidColorBrush x:Key="BrushTextMuted" Color="#4E8BFC"/>
    <!-- 🔳 Бордер -->
    <SolidColorBrush x:Key="BrushBorder" Color="#BA9B60"/>
    <!-- 🟢 Подключён -->
    <SolidColorBrush x:Key="BrushConnected" Color="#A6E3A1"/>
    <!-- 🔴 Отключён -->
    <SolidColorBrush x:Key="BrushDisconnected" Color="#91423D"/>
    <!-- ▶  Кнопка Подключить -->
    <SolidColorBrush x:Key="BrushButtonConnect" Color="#A6E3A1"/>
    <!-- ■  Кнопка Отключить -->
    <SolidColorBrush x:Key="BrushButtonStop" Color="#F38BA8"/>
    <!-- 📡 Кнопка Пинг -->
    <SolidColorBrush x:Key="BrushButtonPing" Color="#3B7CFF"/>
    <!-- 📥 Кнопка Загрузить -->
    <SolidColorBrush x:Key="BrushButtonLoad" Color="#89B4FA"/>
    <!-- 🔤 Текст кнопок -->
    <SolidColorBrush x:Key="BrushButtonFg" Color="#000011"/>
    <!-- 🖱  Список ховер -->
    <SolidColorBrush x:Key="BrushListHover" Color="#BE9370"/>
    <!-- ✅ Список выбранный -->
    <SolidColorBrush x:Key="BrushListSelected" Color="#80446E"/>
    <!-- 📑 Вкладка активная -->
    <SolidColorBrush x:Key="BrushTabActive" Color="#824663"/>
    <!-- 📑 Вкладка неактивная -->
    <SolidColorBrush x:Key="BrushTabInactive" Color="#3B1E2E"/>

    <sys:Double x:Key="FontSizeNormal">13</sys:Double>
    <sys:Double x:Key="FontSizeSmall">11</sys:Double>
    <sys:Double x:Key="FontSizeLarge">18</sys:Double>
    <sys:Double x:Key="FontSizeTitle">14</sys:Double>
    <CornerRadius x:Key="CornerRadius">6</CornerRadius>
    <sys:Double x:Key="ScrollBarWidth" xmlns:sys="clr-namespace:System;assembly=mscorlib">35</sys:Double>
    <Thickness x:Key="BorderThickness">1</Thickness>
</ResourceDictionary>
