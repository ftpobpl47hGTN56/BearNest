<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf">

    <SolidColorBrush x:Key="BrushBackground"      Color="#2e3440"/>
    <SolidColorBrush x:Key="BrushSurface"         Color="#272c36"/>
    <SolidColorBrush x:Key="BrushSurface2"        Color="#3b4252"/>
    <SolidColorBrush x:Key="BrushAccent"          Color="#88c0d0"/>
    <SolidColorBrush x:Key="BrushAccentHover"     Color="#a8d8e8"/>
    <SolidColorBrush x:Key="BrushText"            Color="#eceff4"/>
    <SolidColorBrush x:Key="BrushTextMuted"       Color="#616e88"/>
    <SolidColorBrush x:Key="BrushBorder"          Color="#4c566a"/>
    <SolidColorBrush x:Key="BrushConnected"       Color="#a3be8c"/>
    <SolidColorBrush x:Key="BrushDisconnected"    Color="#bf616a"/>
    <SolidColorBrush x:Key="BrushButtonConnect"   Color="#a3be8c"/>
    <SolidColorBrush x:Key="BrushButtonStop"      Color="#bf616a"/>
    <SolidColorBrush x:Key="BrushButtonPing"      Color="#b48ead"/>
    <SolidColorBrush x:Key="BrushButtonLoad"      Color="#88c0d0"/>
    <SolidColorBrush x:Key="BrushButtonFg"        Color="#2e3440"/>
    <SolidColorBrush x:Key="BrushListHover"       Color="#3b4252"/>
    <SolidColorBrush x:Key="BrushListSelected"    Color="#434c5e"/>
    <SolidColorBrush x:Key="BrushTabActive"       Color="#3b4252"/>
    <SolidColorBrush x:Key="BrushTabInactive"     Color="#2e3440"/>

    <sys:Double x:Key="FontSizeNormal"   xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
    <sys:Double x:Key="FontSizeSmall"    xmlns:sys="clr-namespace:System;assembly=mscorlib">11</sys:Double>
    <sys:Double x:Key="FontSizeLarge"    xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
    <sys:Double x:Key="FontSizeTitle"    xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="ScrollBarWidth" xmlns:sys="clr-namespace:System;assembly=mscorlib">35</sys:Double>
    <CornerRadius x:Key="CornerRadius">8</CornerRadius>
    <Thickness x:Key="BorderThickness">1</Thickness>

</ResourceDictionary>